{
  "version": 1,
  "name": "plate_wave_local",
  "output_dir": "outputs",
  "length_unit": "mm",
  "output_unit": "mm",
  "geometry": {"kind": "plate", "parameters": {"length": 120, "width": 80}},
  "mesh": {
    "mode": "auto",
    "scale_fraction": 0.10,
    "wave": {"enabled": true, "frequency_hz": 3000000000,
             "elements_per_wavelength": 10,
             "relative_permittivity": 1, "relative_permeability": 1},
    "local": {"enabled": true, "feature_threshold_fraction": 0.25,
              "near_size_fraction": 0.25, "transition_fraction": 0.08,
              "boxes": [{"min": [0, 0, -1], "max": [20, 20, 1], "size": 2}]}
  }
}
