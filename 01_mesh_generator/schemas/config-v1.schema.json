{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/geometry-mesh/config-v1.schema.json",
  "title": "Geometry surface mesh configuration v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "output_dir",
    "geometry"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "enum": [
        "m",
        "cm",
        "mm",
        "um"
      ],
      "default": "mm"
    },
    "output_unit": {
      "enum": [
        "m",
        "cm",
        "mm",
        "um"
      ],
      "default": "mm"
    },
    "geometry": {
      "$ref": "#/$defs/geometryNode"
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "fixed"
          ]
        },
        "scale_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "chord_tolerance_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "small_feature_divisions": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_size_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "user_size_cap": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "target_size": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "growth_assessment_limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "element_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 4
        },
        "budget_policy": {
          "enum": [
            "respect_features",
            "respect_budget"
          ]
        },
        "narrow_gap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_fraction": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "divisions": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "wave": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "frequency_hz": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "elements_per_wavelength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "relative_permittivity": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "relative_permeability": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "feature_threshold_fraction": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "near_size_fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "transition_fraction": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "boxes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "min",
                  "max",
                  "size"
                ],
                "properties": {
                  "min": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "max": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "improvement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "max_passes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 3
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "Relocate2D",
                  "Laplace2D"
                ]
              }
            },
            "fragment_surface_tags": {
              "type": "array",
              "uniqueItems": true,
              "oneOf": [
                {
                  "maxItems": 0
                },
                {
                  "minItems": 2
                }
              ],
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid_start": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_aspect_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "default": 3
        },
        "min_angle_deg": {
          "type": "number",
          "minimum": 20,
          "maximum": 60,
          "default": 20
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boundary_mode": {
              "enum": [
                "auto",
                "open",
                "closed"
              ],
              "default": "auto"
            },
            "absolute_tolerance": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "relative_tolerance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1e-10
            },
            "protected_gap": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "separated_surface_pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "max_candidate_tests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000,
              "default": 2000000
            }
          }
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic": {
          "type": "boolean",
          "default": true
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "case": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[\\w-]*$"
        }
      }
    }
  },
  "$defs": {
    "geometryNode": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "plate",
            "disk",
            "sphere",
            "box",
            "cylinder",
            "ogive",
            "cad",
            "fuse",
            "cut",
            "intersect"
          ]
        },
        "path": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "origin": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "D": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "L": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "t": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "objects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/geometryNode"
          }
        }
      }
    }
  }
}
